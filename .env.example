# ---------- WHOOP (developer-dashboard.whoop.com) ----------
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8000/callback

# ---------- Database (Supabase -> Connect -> Session pooler) ----------
DATABASE_URL=

# ---------- Google Calendar (Google Cloud Console -> OAuth client, type "Desktop app") ----------
# Path to the downloaded OAuth client JSON. The secrets/ folder is git-ignored.
GOOGLE_CLIENT_SECRET_FILE=secrets/google_client_secret.json
# Comma-separated calendar ids to read. "primary" is your main calendar.
GOOGLE_CALENDAR_IDS=primary

# ---------- Credential storage ----------
# "file" keeps OAuth tokens in .tokens/; "db" keeps them encrypted in Postgres (needed for
# the daily GitHub Actions job). Generate the key with `make gen-key`.
TOKEN_STORE=file
TOKEN_ENCRYPTION_KEY=

# ---------- Daily email report (Gmail: Google Account -> Security -> App passwords) ----------
SMTP_USER=
SMTP_PASSWORD=
REPORT_EMAIL_TO=
REPORT_TIMEZONE=America/Los_Angeles

# ---------- Email action links (see render.yaml) ----------
# Public URL of the hosted endpoint, e.g. https://recovery-lab.onrender.com (no trailing slash).
# Leave empty to send emails without action buttons.
PUBLIC_BASE_URL=
# Secret for signing the links. Generate with `make gen-key`; use a different value from
# TOKEN_ENCRYPTION_KEY.
ACTION_SIGNING_KEY=

# ---------- Anthropic (platform.claude.com) -- optional ----------
# Rewords the daily focus in friendlier language. Numbers are checked in code; without a key,
# the built-in template is used.
ANTHROPIC_API_KEY=
# LLM_MODEL=claude-haiku-5-5
